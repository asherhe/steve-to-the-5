# Set these in the server environment; this file is not loaded automatically.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVER_KEY=YOUR_SERVER_ONLY_SECRET_OR_SERVICE_ROLE_KEY
SPHEREX_COMPARISON_BASE_URL=http://127.0.0.1:8000
WISE_COMPARISON_BASE_URL=http://127.0.0.1:8020
SPHEREX_CATALOG_BASE_URL=http://127.0.0.1:8010
# Use a durable volume in deployment; retained FITS/measurements back saved scores.
SPHEREX_POINT_EVIDENCE_DIR=services/findings/.local-data/spectral
