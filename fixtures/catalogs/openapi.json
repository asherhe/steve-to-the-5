    "/api/catalogs/gaia/{source_id}": {
      "get": {
        "summary": "Gaia Detail",
        "operationId": "gaia_detail_api_catalogs_gaia__source_id__get",
        "parameters": [
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Source Id"
            }
          },
          {
            "name": "retry",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "A manual retry: probe archives that are in cooldown.",
              "default": false,
              "title": "Retry"
            },
            "description": "A manual retry: probe archives that are in cooldown."
          }
        ],
        "responses": {
