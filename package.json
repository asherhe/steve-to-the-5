{
  "name": "steve-to-the-5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --success all --names viewer,gaia,spherex,wise \"npm:dev:viewer\" \"npm:dev:gaia\" \"npm:dev:spherex\" \"npm:dev:wise\"",
    "dev:viewer": "vite web/src/viewer --strictPort",
    "dev:gaia": "node scripts/dev-backend.mjs gaia",
    "dev:spherex": "node scripts/dev-backend.mjs spherex",
    "dev:wise": "node scripts/dev-backend.mjs wise",
    "dev:findings": "node scripts/dev-backend.mjs findings",
    "preview": "vite preview web/src/viewer --strictPort",
    "check": "tsc --project web/src/viewer/tsconfig.json",
    "generate:archive-types": "openapi-typescript fixtures/archive/openapi.json -o web/src/viewer/archive.generated.ts",
    "build": "npm run check && vite build web/src/viewer",
    "generate:catalog-types": "openapi-typescript fixtures/catalogs/openapi.json -o web/src/inspector/catalog.generated.ts"
  },
  "dependencies": {
    "aladin-lite": "3.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "9.2.1",
    "openapi-typescript": "7.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
